@model ArchivePlayer.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="min-h-screen bg-netflix-black p-8">
    <div class="max-w-md mx-auto">
        <h1 class="text-3xl font-bold text-white mb-8 text-center">Edit Profile</h1>

        <div asp-validation-summary="ModelOnly" class="text-red-500 text-center mb-4"></div>

        <form asp-action="Profile" method="post" class="space-y-6">
            <div>
                <label asp-for="DisplayName" class="block text-gray-300 text-sm font-semibold mb-2">Display Name</label>
                <input asp-for="DisplayName" class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red transition" />
                <span asp-validation-for="DisplayName" class="text-red-500 text-xs mt-1"></span>
            </div>

            <div>
                <label class="block text-gray-300 text-sm font-semibold mb-2">Email</label>
                <input type="text" value="@Model.Email" readonly class="w-full bg-gray-800 text-gray-500 border border-gray-700 rounded px-4 py-3 cursor-not-allowed" />
                <p class="text-gray-500 text-xs mt-2">Email cannot be changed.</p>
            </div>

            <button type="submit" class="w-full bg-netflix-red hover:bg-red-700 text-white font-semibold py-3 rounded transition">
                Save Changes
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="/" class="text-gray-400 hover:text-white transition">← Back to Home</a>
        </div>
    </div>
</div>
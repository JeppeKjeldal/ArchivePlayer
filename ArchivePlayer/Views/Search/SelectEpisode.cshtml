@model ArchivePlayer.Models.EpisodeSelectionViewModel

@{
    ViewData["Title"] = "Select Episode";
}

<div class="min-h-screen bg-netflix-black text-white p-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <a href="/Search" class="text-gray-400 hover:text-white flex items-center gap-2 mb-4 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Back to Search
            </a>
            <h1 class="text-3xl font-bold mb-2">@Model.Title</h1>
            <p class="text-gray-400">Select an episode to add to your library.</p>
        </div>

        <!-- Episode List -->
        <div class="bg-netflix-dark rounded-lg border border-gray-800 overflow-hidden">
            <form asp-action="AddSelectedEpisode" method="post">
                <input type="hidden" name="Identifier" value="@Model.Identifier" />
                
                <div class="max-h-[60vh] overflow-y-auto p-4 space-y-2">
                    @foreach (var file in Model.AvailableFiles)
                    {
                        <label class="flex items-center p-3 rounded hover:bg-gray-800 cursor-pointer transition border border-transparent hover:border-gray-700">
                            <input type="radio" name="SelectedFile" value="@file" class="w-4 h-4 text-netflix-red bg-gray-700 border-gray-600 focus:ring-netflix-red focus:ring-2" required />
                            <span class="ml-3 text-gray-200 font-medium">@file</span>
                        </label>
                    }
                </div>

                <!-- Submit Button -->
                <div class="p-4 bg-gray-900 border-t border-gray-800 flex justify-end">
                    <button type="submit" class="bg-netflix-red text-white px-6 py-2 rounded font-semibold hover:bg-red-700 transition">
                        Add to Library
                    </button
                </div>
            </form>
        </div>
    </div>
</div>
@model ArchivePlayer.Models.SearchInputModel

@{
    ViewData["Title"] = "Add Source";
    var categories = ViewBag.ExistingCategories as List<string> ?? new List<string>();
}

<div class="min-h-screen bg-netflix-black flex flex-col items-center p-8">
    <div class="w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-white mb-8 text-center">Add to Your Library</h1>

        <!-- Tabs -->
        <div class="flex border-b border-gray-700 mb-6">
            <button id="tabSearch" class="flex-1 py-3 text-center text-lg font-semibold text-netflix-red border-b-2 border-netflix-red transition" onclick="switchTab('search')">
                🔍 Search Archive.org
            </button>
            <button id="tabUrl" class="flex-1 py-3 text-center text-lg font-semibold text-gray-400 hover:text-white transition" onclick="switchTab('url')">
                🔗 Paste Direct Link
            </button>
        </div>

        <!-- TAB 1: Live Search -->
        <div id="contentSearch" class="block">
            <div class="bg-netflix-dark p-6 rounded-lg border border-gray-800 mb-6">
                <div class="flex gap-4">
                    <input type="text" id="searchQuery" placeholder="e.g., Ultimate Spider-Man, Chowder, public domain movies..." 
                           class="flex-1 bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red"
                           onkeydown="if(event.key === 'Enter') performSearch()">
                    <button onclick="performSearch()" class="bg-netflix-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold transition">
                        Search
                    </button>
                </div>
                
                <!-- Default Category for Search Adds -->
                <div class="mt-4 flex items-center gap-3">
                    <label class="text-gray-400 text-sm">Add to category:</label>
                    <select id="searchCategory" class="bg-gray-900 text-white border border-gray-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-netflix-red">
                        <option value="Uncategorized">Uncategorized</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Search Results Grid -->
            <div id="searchResults" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                <div id="searchPlaceholder" class="col-span-full text-center py-12 text-gray-500">
                    <p>Type a query above to find content on Archive.org</p>
                </div>
            </div>
            
            <div id="searchLoading" class="hidden text-center py-12">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-netflix-red"></div>
                <p class="text-gray-400 mt-2">Searching Archive.org...</p>
            </div>

            <div id="loadMoreContainer" class="hidden text-center mt-8">
                <button onclick="loadMore()" id="loadMoreBtn" class="bg-gray-800 hover:bg-gray-700 text-white font-semibold py-3 px-8 rounded-lg border border-gray-700 transition">
                    Load More Results
                </button>
            </div>
        </div>

        <!-- TAB 2: Direct URL -->
        <div id="contentUrl" class="hidden">
            <div class="bg-netflix-dark p-6 rounded-lg border border-gray-800">
                <form asp-action="AddSource" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
                    
                    <div class="mb-4">
                        <label class="block text-gray-300 text-sm font-semibold mb-2">Archive.org URL or Identifier</label>
                        <input asp-for="InputString" class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red" 
                               placeholder="https://archive.org/details/ultimate-spider-man-dktale OR just ultimate-spider-man-dktale" required />
                        <span asp-validation-for="InputString" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <div class="mb-6">
                        <label class="block text-gray-300 text-sm font-semibold mb-2">Category</label>
                        <select asp-for="CategoryName" class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red">
                            <option value="Uncategorized">Uncategorized</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="w-full bg-netflix-red hover:bg-red-700 text-white font-semibold py-3 rounded transition">
                        Add to Library
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const liveSearchUrl = '@Url.Action("LiveSearch", "Search")';
        const addSourceUrl = '@Url.Action("AddSource", "Search")';
        
        let currentPage = 1;
        let currentQuery = '';
        let isSearching = false;

        function switchTab(tab) {
            const tabSearch = document.getElementById('tabSearch');
            const tabUrl = document.getElementById('tabUrl');
            const contentSearch = document.getElementById('contentSearch');
            const contentUrl = document.getElementById('contentUrl');

            if (tab === 'search') {
                tabSearch.className = 'flex-1 py-3 text-center text-lg font-semibold text-netflix-red border-b-2 border-netflix-red transition';
                tabUrl.className = 'flex-1 py-3 text-center text-lg font-semibold text-gray-400 hover:text-white transition';
                contentSearch.classList.remove('hidden');
                contentUrl.classList.add('hidden');
            } else {
                tabUrl.className = 'flex-1 py-3 text-center text-lg font-semibold text-netflix-red border-b-2 border-netflix-red transition';
                tabSearch.className = 'flex-1 py-3 text-center text-lg font-semibold text-gray-400 hover:text-white transition';
                contentUrl.classList.remove('hidden');
                contentSearch.classList.add('hidden');
            }
        }

        async function performSearch(reset = true) {
            if (isSearching) return;
            
            const queryInput = document.getElementById('searchQuery');
            if (reset) {
                currentQuery = queryInput.value.trim();
                currentPage = 1;
                if (!currentQuery) return;
                
                const resultsContainer = document.getElementById('searchResults');
                const placeholder = document.getElementById('searchPlaceholder');
                if (placeholder) placeholder.remove();
                resultsContainer.innerHTML = '';
                document.getElementById('loadMoreContainer').classList.add('hidden');
            } else {
                currentQuery = queryInput.value.trim();
                if (!currentQuery) return;
            }

            isSearching = true;
            const loading = document.getElementById('searchLoading');
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            
            loading.classList.remove('hidden');
            if (loadMoreBtn) loadMoreBtn.disabled = true;

            try {
                const response = await fetch(`${liveSearchUrl}?query=${encodeURIComponent(currentQuery)}&page=${currentPage}`);
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

                const data = await response.json();
                loading.classList.add('hidden');
                isSearching = false;
                if (loadMoreBtn) loadMoreBtn.disabled = false;

                if (data.results && data.results.length === 0 && currentPage === 1) {
                    document.getElementById('searchResults').innerHTML = '<div class="col-span-full text-center py-12 text-gray-500">No video results found. Try a different search term.</div>';
                    return;
                }

                const category = document.getElementById('searchCategory').value;
                const resultsContainer = document.getElementById('searchResults');

                data.results.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'bg-gray-900 rounded-lg overflow-hidden border border-gray-800 hover:border-netflix-red transition group';
                    card.innerHTML = `
                        <div class="aspect-[2/3] bg-black relative">
                            <img src="${item.thumbnailUrl}" alt="${item.title}" class="w-full h-full object-cover" onerror="this.src='https://via.placeholder.com/300x450?text=No+Image'">
                            <div class="absolute top-2 right-2 bg-black/70 text-white text-xs px-2 py-1 rounded uppercase">${item.mediaType}</div>
                        </div>
                        <div class="p-3">
                            <h3 class="text-white font-semibold text-sm line-clamp-2 mb-3" title="${item.title}">${item.title}</h3>
                            <form action="${addSourceUrl}" method="post" class="flex gap-2">
                                <input type="hidden" name="InputString" value="${item.identifier}" />
                                <input type="hidden" name="CategoryName" value="${category}" />
                                <button type="submit" class="flex-1 bg-netflix-red hover:bg-red-700 text-white text-sm font-semibold py-2 rounded transition">
                                    Add
                                </button>
                            </form>
                        </div>
                    `;
                    resultsContainer.appendChild(card);
                });

                const loadMoreContainer = document.getElementById('loadMoreContainer');
                if (data.hasMoreResults) {
                    loadMoreContainer.classList.remove('hidden');
                } else {
                    loadMoreContainer.classList.add('hidden');
                }

            } catch (error) {
                loading.classList.add('hidden');
                isSearching = false;
                if (loadMoreBtn) loadMoreBtn.disabled = false;
                
                if (currentPage === 1) {
                    document.getElementById('searchResults').innerHTML = '<div class="col-span-full text-center py-12 text-red-500">An error occurred while searching.</div>';
                }
                console.error('Search error:', error);
            }
        }

        function loadMore() {
            currentPage++;
            performSearch(false);
        }
    </script>
}
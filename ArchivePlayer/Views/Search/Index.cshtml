@model ArchivePlayer.Models.SearchInputModel

@{
    ViewData["Title"] = "Add Content";
    var existingCategories = ViewBag.ExistingCategories as List<string> ?? new List<string>();
}

<div class="min-h-screen bg-netflix-black p-8">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-3xl font-bold text-white mb-8 text-center">Add Content to Your Library</h1>

        <!-- Tab Navigation -->
        <div class="flex border-b border-gray-700 mb-6">
            <button id="tabBtnLive" class="flex-1 py-3 text-center font-semibold text-netflix-red border-b-2 border-netflix-red transition" onclick="switchTab('live')">
                🔍 Live Search Archive.org
            </button>
            <button id="tabBtnDirect" class="flex-1 py-3 text-center font-semibold text-gray-400 hover:text-white transition" onclick="switchTab('direct')">
                🔗 Add by Direct URL
            </button>
        </div>

        <!-- TAB 1: Live Search -->
        <div id="tab-live" class="block">
            <form id="liveSearchForm" class="space-y-6">
                <div>
                    <label class="block text-gray-300 text-sm font-semibold mb-2">Search Archive.org</label>
                    <div class="flex gap-2">
                        <input type="text" id="searchInput"
                               class="flex-1 bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red transition"
                               placeholder="e.g., spider-man, cartoon, movie" />
                        <button type="button" id="searchButton" class="bg-netflix-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold transition">
                            Search
                        </button>
                    </div>
                </div>
            </form>

            <!-- Search Results Container -->
            <div id="searchResults" class="hidden mt-6">
                <h3 class="text-xl font-semibold text-white mb-4">Results</h3>
                <div id="resultsContainer" class="grid grid-cols-2 md:grid-cols-3 gap-4 max-h-[60vh] overflow-y-auto pr-2"></div>
            </div>
        </div>

        <!-- TAB 2: Add by Direct URL -->
        <div id="tab-direct" class="hidden">
            <form asp-action="AddSource" method="post" class="space-y-6">
                <div>
                    <label class="block text-gray-300 text-sm font-semibold mb-2">Archive.org URL or Identifier</label>
                    <input type="text" asp-for="InputString" 
                           class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red transition" 
                           placeholder="https://archive.org/details/your-identifier-here" required />
                    <p class="text-gray-500 text-xs mt-2">Paste the full URL or just the identifier (e.g., "cartoon-name-1999").</p>
                </div>

                <div>
                    <label class="block text-gray-300 text-sm font-semibold mb-2">Category (Optional)</label>
                    <input type="text" asp-for="CategoryName" list="categorySuggestions" 
                           class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red transition" 
                           placeholder="e.g., Movies, TV Shows, Anime" />
                    
                    <datalist id="categorySuggestions">
                        @foreach (var category in existingCategories)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    <p class="text-gray-500 text-xs mt-2">Leave blank to default to "Uncategorized".</p>
                </div>

                <button type="submit" class="w-full bg-netflix-red hover:bg-red-700 text-white font-semibold py-3 rounded transition flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                    Add to Library
                </button>
            </form>
        </div>

        <!-- Back Link -->
        <div class="mt-8 text-center">
            <a href="/" class="text-gray-400 hover:text-white flex items-center justify-center gap-2 transition">
                ← Back to Library
            </a>
        </div>
    </div>
</div>

<!-- Category Suggestion Modal -->
<div id="categoryModal" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50">
    <div class="bg-netflix-dark border border-gray-700 rounded-lg p-6 w-full max-w-md">
        <h3 class="text-xl font-bold text-white mb-4">Choose a Category</h3>
        <p class="text-gray-400 text-sm mb-4">Based on TMDB, here are some suggested categories for this content:</p>
        
        <div id="suggestionLoading" class="text-center py-4">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-netflix-red"></div>
        </div>
        
        <div id="suggestionContent" class="hidden">
            <div id="suggestionChips" class="flex flex-wrap gap-2 mb-6"></div>
            
            <div class="mb-4">
                <label class="block text-gray-300 text-sm font-semibold mb-2">Or type your own:</label>
                <input type="text" id="customCategoryInput" 
                       class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-2 focus:outline-none focus:border-netflix-red" 
                       placeholder="Custom category name" />
            </div>
        </div>

        <div class="flex gap-3 justify-end">
            <button id="closeModalBtn" class="px-4 py-2 text-gray-400 hover:text-white transition">Cancel</button>
            <button id="confirmCategoryBtn" class="px-4 py-2 bg-netflix-red hover:bg-red-700 text-white rounded font-semibold transition">Add to Library</button>
        </div>
    </div>
</div>

<!-- Hidden form for final submission after category selection -->
<form id="finalAddForm" method="post" asp-action="AddSource" class="hidden">
    <input type="hidden" name="InputString" id="finalInputString" />
    <input type="hidden" name="CategoryName" id="finalCategoryName" />
</form>

@section Scripts {
    <script type="application/json" id="searchConfig">
    {
        "liveSearchUrl": "/api/v1/search/archive",
        "addSourceUrl": "@Url.Action("AddSource", "Search")",
        "getCategorySuggestionsUrl": "/api/v1/search/category-suggestions"
    }
    </script>
    <script src="~/js/search-page.js?v=5"></script>
    <script>
        function switchTab(tabName) {
            const liveTab = document.getElementById('tab-live');
            const directTab = document.getElementById('tab-direct');
            const liveBtn = document.getElementById('tabBtnLive');
            const directBtn = document.getElementById('tabBtnDirect');

            if (tabName === 'live') {
                liveTab.classList.remove('hidden');
                directTab.classList.add('hidden');
                liveBtn.classList.add('text-netflix-red', 'border-b-2', 'border-netflix-red');
                liveBtn.classList.remove('text-gray-400');
                directBtn.classList.remove('text-netflix-red', 'border-b-2', 'border-netflix-red');
                directBtn.classList.add('text-gray-400');
            } else {
                directTab.classList.remove('hidden');
                liveTab.classList.add('hidden');
                directBtn.classList.add('text-netflix-red', 'border-b-2', 'border-netflix-red');
                directBtn.classList.remove('text-gray-400');
                liveBtn.classList.remove('text-netflix-red', 'border-b-2', 'border-netflix-red');
                liveBtn.classList.add('text-gray-400');
            }
        }
    </script>
}
@model ArchivePlayer.Models.SearchInputModel

@{
    ViewData["Title"] = "Add Source";
    var categories = ViewBag.ExistingCategories as List<string> ?? new List<string>();
}

<div class="min-h-screen bg-netflix-black flex flex-col items-center p-8">
    <div class="w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-white mb-8 text-center">Add to Your Library</h1>

        <!-- Tabs -->
        <div class="flex border-b border-gray-700 mb-6">
            <button id="tabSearch" class="flex-1 py-3 text-center text-lg font-semibold text-netflix-red border-b-2 border-netflix-red transition">
                🔍 Search Archive.org
            </button>
            <button id="tabUrl" class="flex-1 py-3 text-center text-lg font-semibold text-gray-400 hover:text-white transition">
                🔗 Paste Direct Link
            </button>
        </div>

        <!-- TAB 1: Live Search -->
        <div id="contentSearch" class="block">
            <div class="bg-netflix-dark p-6 rounded-lg border border-gray-800 mb-6">
                <div class="flex gap-4">
                    <input type="text" id="searchQuery" placeholder="e.g., Ultimate Spider-Man, Chowder, public domain movies..." 
                           class="flex-1 bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red">
                    <button class="bg-netflix-red hover:bg-red-700 text-white px-6 py-3 rounded font-semibold transition">
                        Search
                    </button>
                </div>
            </div>

            <!-- Search Results Grid -->
            <div id="searchResults" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                <div id="searchPlaceholder" class="col-span-full text-center py-12 text-gray-500">
                    <p>Type a query above to find content on Archive.org</p>
                </div>
            </div>
            
            <div id="searchLoading" class="hidden text-center py-12">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-netflix-red"></div>
                <p class="text-gray-400 mt-2">Searching Archive.org...</p>
            </div>

            <div id="loadMoreContainer" class="hidden text-center mt-8">
                <button id="loadMoreBtn" class="bg-gray-800 hover:bg-gray-700 text-white font-semibold py-3 px-8 rounded-lg border border-gray-700 transition">
                    Load More Results
                </button>
            </div>
        </div>

        <!-- TAB 2: Direct URL -->
        <div id="contentUrl" class="hidden">
            <div class="bg-netflix-dark p-6 rounded-lg border border-gray-800">
                <form asp-action="AddSource" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
                    
                    <div class="mb-4">
                        <label class="block text-gray-300 text-sm font-semibold mb-2">Archive.org URL or Identifier</label>
                        <input asp-for="InputString" class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red" 
                               placeholder="https://archive.org/details/ultimate-spider-man-dktale OR just ultimate-spider-man-dktale" required />
                        <span asp-validation-for="InputString" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <div class="mb-6">
                        <label class="block text-gray-300 text-sm font-semibold mb-2">Category</label>
                        <select asp-for="CategoryName" class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-3 focus:outline-none focus:border-netflix-red">
                            <option value="Uncategorized">Uncategorized</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="w-full bg-netflix-red hover:bg-red-700 text-white font-semibold py-3 rounded transition">
                        Add to Library
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Category Selection Modal -->
<div id="categoryModal" class="fixed inset-0 bg-black/80 flex items-center justify-center z-50 hidden">
    <div class="bg-netflix-dark border border-gray-700 rounded-lg p-6 w-full max-w-md mx-4 shadow-2xl">
        <h3 class="text-xl font-bold text-white mb-2">Choose a Category</h3>
        <p id="modalItemTitle" class="text-gray-400 text-sm mb-4 line-clamp-2"></p>
        
        <div id="modalLoading" class="text-center py-4">
            <div class="inline-block animate-spin rounded-full h-6 w-6 border-b-2 border-netflix-red"></div>
            <p class="text-gray-500 text-sm mt-2">Fetching suggestions...</p>
        </div>

        <div id="modalContent" class="hidden">
            <label class="block text-gray-300 text-sm font-semibold mb-2">Suggested Categories</label>
            <div id="suggestionChips" class="flex flex-wrap gap-2 mb-4"></div>

            <label class="block text-gray-300 text-sm font-semibold mb-2">Or type a custom category</label>
            <form id="categoryForm" action="" method="post">
                <input type="hidden" name="InputString" id="modalIdentifier" />
                <input type="text" name="CategoryName" id="modalCategoryInput" 
                       class="w-full bg-gray-900 text-white border border-gray-700 rounded px-4 py-2 mb-4 focus:outline-none focus:border-netflix-red" 
                       placeholder="e.g., My Favorites, Watch Later, Uncategorized" />
                
                <div class="flex gap-3">
                    <button type="button" id="closeModalBtn" class="flex-1 bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 rounded transition">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 bg-netflix-red hover:bg-red-700 text-white font-semibold py-2 rounded transition">
                        Add to Library
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="application/json" id="searchConfig">
{
    "liveSearchUrl": "@Url.Action("LiveSearch", "Search")",
    "addSourceUrl": "@Url.Action("AddSource", "Search")",
    "getCategorySuggestionsUrl": "@Url.Action("GetCategorySuggestions", "Search")"
}
</script>

@section Scripts {
    <script src="~/js/search-page.js?v=1"></script>
}
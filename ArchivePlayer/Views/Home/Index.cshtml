@{
    ViewData["Title"] = "My Library";
    var userName = ViewBag.UserName as string ?? "User";
}

<div class="min-h-screen bg-netflix-black p-8">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-white mb-2">Welcome back, @userName</h1>
            <p class="text-gray-400">Continue watching or browse your library</p>
        </div>

        <!-- Continue Watching Section -->
        <section id="continueWatchingSection" class="mb-12 hidden">
            <h2 class="text-2xl font-bold text-white mb-4">Continue Watching</h2>
            <div id="continueWatchingGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                <!-- Cards injected by JS -->
            </div>
        </section>

        <!-- Library by Category -->
        <section id="librarySection">
            <h2 class="text-2xl font-bold text-white mb-4">Your Library</h2>
            <div id="libraryContainer">
                <!-- Category sections injected by JS -->
            </div>
        </section>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-16">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-gray-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
            </svg>
            <h3 class="text-xl font-semibold text-white mb-2">Your library is empty</h3>
            <p class="text-gray-400 mb-6">Start by adding some content from Archive.org</p>
            <a href="/Search" class="inline-block bg-netflix-red hover:bg-red-700 text-white font-semibold px-6 py-3 rounded transition">
                Add Content
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home-page.js?v=2"></script>
}
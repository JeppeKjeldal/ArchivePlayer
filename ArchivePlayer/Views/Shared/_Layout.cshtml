<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArchivePlayer</title>

    <!-- Tailwind CSS Play CDN (for development) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Netflix-style colors -->
    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            netflix: {
                                black: '#141414',
                                dark: '#181818',
                                red: '#E50914',
                                gray: '#808080'
                            }
                        }
                    }
                }
            }
    </script>

    <style>
            body {
                background-color: #141414;
                color: white;
                font-family: 'Helvetica Neue', Arial, sans-serif;
            }
    </style>
</head>
<body class="min-h-screen">

    <!-- Navbar -->
    <nav class="fixed top-0 w-full z-50 bg-netflix-black/90 px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-8">
            <a href="/" class="text-netflix-red text-2xl font-bold tracking-tight">ARCHIVEPLAYER</a>
            <ul class="flex gap-6 text-sm">
                <li><a href="/" class="hover:text-gray-300 transition">Home</a></li>
                <li><a href="/Search" class="hover:text-gray-300 transition">Add Source</a></li>
                <li><a href="/Library" class="hover:text-gray-300 transition">My Library</a></li>
            </ul>
        </div>

        <div class="flex items-center gap-4">
            @if (User.Identity.IsAuthenticated)
            {
                <!-- User is logged in -->
                <span class="text-gray-300 text-sm">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    <button type="submit" class="text-gray-300 hover:text-white text-sm transition">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <!-- User is NOT logged in -->
                <a href="/Account/Login" class="text-gray-300 hover:text-white text-sm transition">Login</a>
                <a href="/Account/Register" class="bg-netflix-red text-white px-4 py-2 rounded text-sm font-semibold hover:bg-red-700 transition">
                    Register
                </a>
            }
        </div>
    </nav>

    <!-- Main Content -->
    <main class="pt-16">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-netflix-black py-8 px-8 text-netflix-gray text-sm border-t border-gray-800 mt-12">
        <p>&copy; @DateTime.Now.Year - ArchivePlayer. Streaming from Archive.org.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
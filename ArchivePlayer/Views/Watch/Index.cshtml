@model ArchivePlayer.Models.MediaItem

@{
    ViewData["Title"] = Model?.Title ?? "Watch";
    var videoFiles = ViewBag.VideoFiles as List<string> ?? new List<string>();
    var hasMultipleFiles = videoFiles.Count > 1;
}

<div class="min-h-screen bg-netflix-black flex flex-col items-center p-4">
    
    <!-- Back Button -->
    <div class="w-full max-w-5xl mb-4">
        <a href="/" class="text-gray-400 hover:text-white flex items-center gap-2 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Library
        </a>
    </div>

    <!-- Video Player Container -->
    <div class="w-full max-w-5xl aspect-video bg-black rounded-lg overflow-hidden shadow-2xl border border-gray-800">
        <iframe 
            id="videoPlayer"
            src="https://archive.org/embed/@(Model?.Identifier)" 
            width="100%" 
            height="100%" 
            frameborder="0" 
            webkitallowfullscreen="true" 
            mozallowfullscreen="true" 
            allowfullscreen>
        </iframe>
    </div>

    <!-- Video Info -->
    <div class="w-full max-w-5xl mt-6">
        <h1 class="text-3xl font-bold text-white mb-2">@(Model?.Title ?? "Unknown Title")</h1>
        <p class="text-gray-400">@(Model?.Description ?? "No description available.")</p>
    </div>

    <!-- Episode Selector (Only shows if multiple files exist) -->
    @if (hasMultipleFiles)
    {
        <div class="w-full max-w-5xl mt-8 bg-netflix-dark rounded-lg border border-gray-800 p-6">
            <h2 class="text-2xl font-bold text-white mb-4">Episodes</h2>
            
            <!-- Season Dropdown -->
            <div class="mb-6">
                <label class="text-gray-400 text-sm mb-2 block">Select Season</label>
                <select id="seasonSelect" class="w-full bg-gray-800 text-white border border-gray-700 rounded px-4 py-2 focus:outline-none focus:border-netflix-red">
                    <option value="all">All Episodes</option>
                </select>
            </div>

            <!-- Episodes Horizontal Slider -->
            <div id="episodesContainer" class="flex overflow-x-auto gap-3 pb-4 scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-gray-900">
                <!-- Episodes will be populated by JavaScript -->
            </div>
        </div>

        <script>
            // Parse episodes and group by season
            const episodes = @Html.Raw(Json.Serialize(videoFiles));
            const seasonMap = {};

            episodes.forEach(file => {
                // Try to extract season number from filename
                const seasonMatch = file.match(/S(\d+)/i) || file.match(/Season\s*(\d+)/i) || file.match(/(\d+)x\d+/i);
                const season = seasonMatch ? `Season ${seasonMatch[1].padStart(2, '0')}` : 'Other';
                
                if (!seasonMap[season]) {
                    seasonMap[season] = [];
                }
                seasonMap[season].push(file);
            });

            // Populate season dropdown
            const seasonSelect = document.getElementById('seasonSelect');
            Object.keys(seasonMap).sort().forEach(season => {
                const option = document.createElement('option');
                option.value = season;
                option.textContent = `${season} (${seasonMap[season].length} episodes)`;
                seasonSelect.appendChild(option);
            });

            // Track if we've switched to video mode yet
            let videoMode = false;

            // Filter episodes by season
            seasonSelect.addEventListener('change', function() {
                const selectedSeason = this.value;
                const episodesContainer = document.getElementById('episodesContainer');
                
                episodesContainer.innerHTML = '';
                
                // FIXED: Only show episodes from the selected season
                const filesToShow = selectedSeason === 'all' 
                    ? episodes 
                    : (seasonMap[selectedSeason] || []);

                filesToShow.forEach(file => {
                    const div = document.createElement('div');
                    div.className = 'flex-shrink-0 w-64 bg-gray-800 rounded-lg p-4 hover:bg-gray-700 cursor-pointer transition border border-gray-700 hover:border-netflix-red';
                    div.setAttribute('data-filename', file);
                    
                    // Extract episode number if possible
                    const epMatch = file.match(/E(\d+)/i) || file.match(/Ep(?:isode)?\s*(\d+)/i) || file.match(/\d+x(\d+)/i);
                    const epNum = epMatch ? epMatch[1] : '';
                    const displayName = epNum ? `Episode ${epNum}` : file;
                    
                    div.innerHTML = `
                        <div class="text-center">
                            <p class="text-white font-semibold text-sm truncate">${displayName}</p>
                            <p class="text-gray-400 text-xs mt-1 truncate" title="${file}">${file}</p>
                        </div>
                    `;
                    
                    div.addEventListener('click', function() {
                        const filename = this.getAttribute('data-filename');
                        const identifier = '@(Model?.Identifier)';
                        const newSrc = `https://archive.org/download/${identifier}/${encodeURIComponent(filename)}`;
                        
                        const playerContainer = document.getElementById('videoPlayer').parentElement;
                        
                        if (!videoMode) {
                            playerContainer.innerHTML = `
                                <video 
                                    id="videoPlayer"
                                    controls 
                                    autoplay
                                    class="w-full h-full">
                                </video>
                            `;
                            videoMode = true;
                        }
                        
                        const videoElement = document.getElementById('videoPlayer');
                        videoElement.src = newSrc;
                        videoElement.load();
                        videoElement.play();
                    });
                    
                    episodesContainer.appendChild(div);
                });
            });

            // Initial load - show all episodes
            seasonSelect.dispatchEvent(new Event('change'));
        </script>
    }
</div>